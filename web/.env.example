# Copie para .env (ou gere com scripts/gerar-env.sh). Nunca commite o .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Estilo do mapa (MapLibre). Padrão: OpenFreeMap Liberty.
VITE_MAP_STYLE_URL=
# Versão do APK exibida na página de download e nome do arquivo em public/downloads/.
VITE_APK_VERSION=
# URL (absoluta ou relativa) do APK; ex.: /downloads/nupdec-conecta.apk
VITE_APK_URL=
