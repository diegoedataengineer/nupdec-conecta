# Nupdec Conecta — SPA com BrowserRouter em hospedagem Apache/LiteSpeed (Hostinger).
# Qualquer rota que não seja arquivo ou pasta real cai no index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# APK: tipo correto para o Android reconhecer o download.
AddType application/vnd.android.package-archive .apk

<IfModule mod_headers.c>
  # o index.html não pode ser cacheado: é ele que aponta para o bundle novo.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # assets do Vite têm hash no nome: cache longo.
  <FilesMatch "\.(js|css|woff2|svg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
